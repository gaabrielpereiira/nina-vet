# Public browser configuration. Copy to .env.local for local development.
# Set these in Dokploy for builds targeting the new backend.
VITE_SUPABASE_URL=https://api.nina.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-destination-public-key
VITE_SUPABASE_PROJECT_ID=

# Database passwords, service_role, SMTP and AI keys belong exclusively
# in the backend environment, never in a VITE_ variable.
