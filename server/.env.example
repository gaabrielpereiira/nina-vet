# Server secrets: never use VITE_ prefixes or commit the filled file.
NODE_ENV=production
PORT=3000
API_ORIGIN=https://api.nina.sharkassessoria.tech
FRONTEND_ORIGIN=https://nina.sharkassessoria.tech

# Runtime: limited nina_app role, not nina_owner. URL-encode the password.
DATABASE_URL=postgresql://nina_app:REPLACE_ME@nina-vet-mais-ninadb-foiarh:5432/nina
DATABASE_SSL=disable
DATABASE_POOL_SIZE=5
SESSION_TTL_SECONDS=28800

# Fictional examples only, available to admins. No clinical data or WhatsApp sends.
# The real key belongs only in nina-api's server environment in Dokploy.
AI_TESTS_ENABLED=false
GEMINI_API_KEY=

# Enable only after migrations, frontend reset flow and delivery validation.
# Store the real key only in the server's runtime environment.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="Nina Vet <acesso@nina.sharkassessoria.tech>"
# Independent 32-byte key, encoded as 64 hex characters; encrypts queued links.
EMAIL_ENCRYPTION_KEY=

# Only provide this to the one-off migration process, never the running API.
# MIGRATION_DATABASE_URL=postgresql://nina_owner:REPLACE_ME@nina-vet-mais-ninadb-foiarh:5432/nina
