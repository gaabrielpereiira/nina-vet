# Server secrets: never use VITE_ prefixes or commit the filled file.
NODE_ENV=production
PORT=3000
API_ORIGIN=https://api.nina.sharkassessoria.tech
FRONTEND_ORIGIN=https://nina.sharkassessoria.tech

# Runtime: limited nina_app role, not nina_owner. URL-encode the password.
DATABASE_URL=postgresql://nina_app:REPLACE_ME@nina-vet-mais-ninadb-foiarh:5432/nina
DATABASE_SSL=disable
DATABASE_POOL_SIZE=5
SESSION_TTL_SECONDS=28800

# Fictional examples only, available to admins. No clinical data or WhatsApp sends.
# The real key belongs only in nina-api's server environment in Dokploy.
AI_TESTS_ENABLED=false
GEMINI_API_KEY=

# Explicit admin-only VetSoft connection check. No patient sync or agenda writes.
VETSOFT_READ_ONLY_ENABLED=false
VETSOFT_TENANT=
VETSOFT_EMAIL=
# Base64 preserves password characters in env files; it is NOT encryption.
# Keep this value server-only and private, just like the original password.
VETSOFT_PASSWORD_BASE64=

# Signed intake queue only; no automatic replies or clinical writes.
# Apply 0005 + zernio-inbox-role.sql before enabling. Use a new random signing secret.
ZERNIO_WEBHOOK_ENABLED=false
ZERNIO_WEBHOOK_SECRET=
ZERNIO_ACCOUNT_ID=
ZERNIO_PROFILE_ID=
# Provider key stays server-only; the receiver itself makes no provider API calls.
ZERNIO_API_KEY=

# Passive message processing and private files. Both off until migration 0006,
# scoped function grants, a persistent named volume and its initialization marker.
CHANNEL_PROCESSING_ENABLED=false
MEDIA_ENABLED=false
MEDIA_STORAGE_DIR=/app/media
MEDIA_MAX_FILE_BYTES=104857600
MEDIA_MIN_FREE_BYTES=2147483648

# Enable only after migrations, frontend reset flow and delivery validation.
# Store the real key only in the server's runtime environment.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="Nina Vet <acesso@nina.sharkassessoria.tech>"
# Independent 32-byte key, encoded as 64 hex characters; encrypts queued links.
EMAIL_ENCRYPTION_KEY=

# Only provide this to the one-off migration process, never the running API.
# MIGRATION_DATABASE_URL=postgresql://nina_owner:REPLACE_ME@nina-vet-mais-ninadb-foiarh:5432/nina

# Manual WhatsApp pilot, scoped to one approved test conversation.
WHATSAPP_PILOT_ENABLED=false
WHATSAPP_PILOT_CONTACT_ID=
WHATSAPP_PILOT_CONVERSATION_ID=
